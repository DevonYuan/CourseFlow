{
  "name": "courseflow",
  "version": "0.1.0",
  "description": "A desktop homework tracker that solves the limitations of Canvas's to-do app",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "dist/backend/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run --config config/vitest/vitest.config.ts",
    "test:watch": "vitest --config config/vitest/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --build config/tsconfig.json",
    "db:migrate": "tsx scripts/run-migration.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/react-window": "^2.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "ical.js": "^2.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "react-window": "^2.3.0",
    "sql.js": "^1.14.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@playwright/test": "^1.62.1",
    "@rollup/rollup-win32-x64-msvc": "4.20.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.7",
    "electron-vite": "^2.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.3.3",
    "rollup": "4.20.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.courseflow.app",
    "productName": "CourseFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/*.map",
      "!**/node_modules/*.txt"
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false
  }
}
